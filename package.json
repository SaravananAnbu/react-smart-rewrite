{
  "name": "react-smart-rewrite",
  "version": "0.1.0",
  "description": "AI rewrite menu for any textarea or input in React. Users select text, pick Improve, Shorten or Fix grammar, preview the change and replace it. Your key stays on your server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaravananAnbu/react-smart-rewrite.git"
  },
  "homepage": "https://saravanananbu.github.io/react-smart-rewrite/",
  "bugs": {
    "url": "https://github.com/SaravananAnbu/react-smart-rewrite/issues"
  },
  "keywords": [
    "react",
    "ai",
    "rewrite",
    "textarea",
    "input",
    "writing assistant",
    "grammar",
    "text selection",
    "llm",
    "nextjs",
    "hook"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
